PORT=3000
# Address of this server
PUBLIC_URL=https://riverboat21-YOURNAME.koyeb.app
# Where players open the game (your GitHub Pages site). Allowed to call the server.
CLIENT_URL=https://YOUR-GITHUB-NAME.github.io/riverboat21
# Extra allowed origins, comma separated (e.g. a custom domain)
ALLOWED_ORIGINS=
JWT_SECRET=change-me-to-a-long-random-string
# Free hosts (no disk): put your Neon/Postgres connection string here and game data is saved there.
DATABASE_URL=
# Hosts with a disk: local save file (ignored when DATABASE_URL is set)
DATA_FILE=/app/data/db.json

# Admin account (created on first boot; this email can never be registered by anyone else)
ADMIN_EMAIL=mcguiredonavan8@gmail.com
ADMIN_PASSWORD=pick-a-strong-password
ADMIN_NAME=Donavan

# Payments (PayPal Checkout). Leave blank to keep the store and paid entries closed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox while testing, live for real money
PAYPAL_ENV=sandbox

# Ads (Google AdSense / H5 Games Ads). Leave blank for no ads.
ADSENSE_CLIENT=
ADSENSE_BANNER_SLOT=
ADS_TEST_MODE=false
# Local testing only: fake 10-second ad that still pays the reward
SIMULATE_ADS=false
